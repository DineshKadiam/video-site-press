{
    "$schema": "https://schema.tauri.app/config/2",
    "app": {
        "security": {
            "csp": null
        },
        "windows": [
            {
                "height": 600,
                "minHeight": 480,
                "minWidth": 640,
                "title": "Hyper 8 Video System",
                "width": 800
            }
        ],
        "withGlobalTauri": true
    },
    "build": {
        "frontendDist": "launcher"
    },
    "bundle": {
        "active": true,
        "icon": [
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/32x32.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "shortDescription": "A static site generator for video publishing",
        "targets": "all"
    },
    "identifier": "com.simonrepp.hyper8",
    "productName": "Hyper 8"
}
