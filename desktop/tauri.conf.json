{
    "$schema": "https://schema.tauri.app/config/2",
    "app": {
        "security": {
            "capabilities": ["editor", "launcher"],
            "csp": null
        },
        "withGlobalTauri": true
    },
    "build": {
        "frontendDist": "launcher"
    },
    "bundle": {
        "active": true,
        "category": "Video",
        "copyright": "2025 Simon Repp and contributors",
        "homepage": "https://hyper8.org",
        "icon": [
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/32x32.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "license": "AGPL-3.0-or-later",
        "publisher": "Simon Repp",
        "shortDescription": "A static site generator for video publishing",
        "targets": "all"
    },
    "identifier": "com.simonrepp.hyper8",
    "mainBinaryName": "hyper8",
    "productName": "Hyper 8"
}
